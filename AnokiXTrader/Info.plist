<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is used to show your position on the map and help you find and confirm delivery addresses when placing orders.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>109.176.30.129</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
		Schemes the Support Centre probes with canOpenURL before launching them.
		Without this list the checks silently return false and WhatsApp / the dialler /
		the mail client are never opened.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>tel</string>
		<string>mailto</string>
	</array>
	<!--
		anokix:// — the return_url handed to PayCloud when a wallet top-up starts, so the
		checkout page can hand the trader back to the app when it is done. It carries no
		result we act on: the wallet is credited by PayCloud's signed webhook, verified
		server-side, so the redirect only prompts a status poll (see TopUpSheet).
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.anokix.traderapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anokix</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
